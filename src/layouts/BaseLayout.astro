---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Optional path to a social share image, relative to site root */
  ogImage?: string;
  /** Additional JSON-LD graph objects to emit alongside the site-wide Organization schema (FAQPage, BreadcrumbList, Service, Person, etc.) */
  schema?: Record<string, unknown>[];
  /** Set true for error/utility pages that shouldn't be indexed */
  noindex?: boolean;
}

const { title, description, ogImage = '/og-image-v2.jpg', schema = [], noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const logoURL = new URL('/favicon.svg', Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://www.indispensabledigital.com/#organization',
  name: 'Indispensable Digital',
  alternateName: 'Indispensable Digital - Performance Marketing Agency',
  description:
    'A performance marketing agency for category-leading consumer and D2C brands worldwide. Growth strategy, brand positioning, Google Ads, Meta Ads, SEO, website development, and content engineered as one integrated system.',
  slogan: 'Built to Make Brands Indispensable',
  serviceType: 'Performance Marketing Agency',
  url: 'https://www.indispensabledigital.com',
  logo: logoURL,
  image: logoURL,
  email: 'contact@indispensabledigital.com',
  telephone: '+91-7000123171',
  priceRange: '$$',
  founder: {
    '@type': 'Person',
    name: 'Gaurav Gangwar',
    jobTitle: 'Founder',
    url: 'https://www.indispensabledigital.com/about/',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'New Delhi',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+91-7000123171',
    email: 'contact@indispensabledigital.com',
    areaServed: 'Worldwide',
    availableLanguage: ['English', 'Hindi'],
  },
  knowsAbout: [
    'Growth Strategy',
    'Brand Positioning',
    'Brand Strategy',
    'PR & Communications',
    'Content Strategy',
    'YouTube Growth',
    'Performance Marketing',
    'Google Ads Management',
    'Meta Ads Management',
    'Technical SEO',
    'Website Development',
    'Conversion Rate Optimization',
    'Ecommerce Marketing',
    'Marketing Analytics',
    'Customer Acquisition',
    'Marketing Intelligence',
  ],
  areaServed: 'Worldwide',
  sameAs: [
    'https://www.linkedin.com/company/indispensabledigital/',
    'https://www.instagram.com/indispensabledigital_/',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://www.indispensabledigital.com/#website',
  name: 'Indispensable Digital',
  url: 'https://www.indispensabledigital.com',
  publisher: { '@id': 'https://www.indispensabledigital.com/#organization' },
  inLanguage: 'en',
};

// Bump this date whenever page content is meaningfully updated - it feeds the
// dateModified freshness signal search engines and AI answer engines use.
const SITE_LAST_UPDATED = '2026-07-21';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL.toString(),
  name: title,
  description,
  isPartOf: { '@id': 'https://www.indispensabledigital.com/#website' },
  about: { '@id': 'https://www.indispensabledigital.com/#organization' },
  inLanguage: 'en',
  datePublished: '2026-07-05',
  dateModified: SITE_LAST_UPDATED,
};

const jsonLdBlocks = [orgSchema, webSiteSchema, webPageSchema, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-0HF33W0NR0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0HF33W0NR0');
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xi2iuhve29");
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Indispensable Digital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <div class="route-curtain" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      const routeCurtainDelay = 430;

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const target = event.target as Element | null;
        const link = target?.closest<HTMLAnchorElement>('a[href]');
        if (!link || link.target || link.hasAttribute('download')) return;

        const next = new URL(link.href, window.location.href);
        if (next.origin !== window.location.origin) return;
        const sameDocument = next.pathname === window.location.pathname && next.search === window.location.search;
        if (sameDocument) return;

        event.preventDefault();
        document.documentElement.classList.add('route-leaving');
        window.setTimeout(() => window.location.assign(next.href), routeCurtainDelay);
      });

      const staggerBlocks = document.querySelectorAll<HTMLElement>('.t-stagger');

      function showText(block: HTMLElement) {
        block.classList.remove('is-hiding');
        block.classList.remove('is-shown');
        void block.offsetHeight;
        block.classList.add('is-shown');
      }

      requestAnimationFrame(() => staggerBlocks.forEach(showText));

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
        const revealSelectors = [
          '.page-hero .wrap > .eyebrow, .page-hero .wrap > h1, .page-hero .wrap > p, .page-hero .wrap > .btn',
          '.section-head > *, .definition-block, .metric, .svc, .case, .step, .blog-card',
          '.why-col h3, .why-col li, .faq-item, .contact-card, .contact-line, .booking-form, .form-field',
          '.visual-story-copy > *, .visual-story-media',
          '.about-flex > *, .prose > *, .legal-content > *, footer .foot-grid > *, footer .foot-bottom',
        ];
        const revealTargets = new Set<HTMLElement>();

        revealSelectors.forEach((selector) => {
          const parentCounts = new Map<Element, number>();
          document.querySelectorAll<HTMLElement>(selector).forEach((target) => {
            if (target.closest('.t-stagger') || revealTargets.has(target)) return;
            const parent = target.parentElement;
            const order = parent ? parentCounts.get(parent) ?? 0 : 0;
            if (parent) parentCounts.set(parent, order + 1);
            const revealModes = ['slide-left', 'lift', 'slide-right', 'soft'];
            target.setAttribute('data-reveal', revealModes[order % revealModes.length]);
            target.style.setProperty('--reveal-delay', `${Math.min(order, 4) * 40}ms`);
            revealTargets.add(target);
          });
        });

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).setAttribute('data-visible', '');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

        revealTargets.forEach((target) => revealObserver.observe(target));

        document.querySelectorAll<HTMLElement>('.t-tilt').forEach((tilt) => {
          const card = tilt.querySelector<HTMLElement>('.t-tilt-card');
          if (!card) return;

          const resetTilt = () => {
            tilt.classList.remove('is-hover');
            card.classList.remove('is-tilting');
            card.style.setProperty('--tilt-rx', '0deg');
            card.style.setProperty('--tilt-ry', '0deg');
          };

          tilt.addEventListener('pointermove', (event) => {
            const bounds = tilt.getBoundingClientRect();
            const px = Math.min(1, Math.max(0, (event.clientX - bounds.left) / bounds.width));
            const py = Math.min(1, Math.max(0, (event.clientY - bounds.top) / bounds.height));
            tilt.classList.add('is-hover');
            card.classList.add('is-tilting');
            card.style.setProperty('--tilt-ry', `${((px - .5) * 7).toFixed(2)}deg`);
            card.style.setProperty('--tilt-rx', `${((.5 - py) * 7).toFixed(2)}deg`);
            card.style.setProperty('--tilt-gx', `${(px * 100).toFixed(1)}%`);
            card.style.setProperty('--tilt-gy', `${(py * 100).toFixed(1)}%`);
          });

          tilt.addEventListener('pointerleave', resetTilt);
          tilt.addEventListener('pointercancel', resetTilt);
          tilt.addEventListener('pointerup', resetTilt);
        });
      }
    </script>
  </body>
</html>
