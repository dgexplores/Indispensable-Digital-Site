---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Optional path to a social share image, relative to site root */
  ogImage?: string;
  /** Additional JSON-LD graph objects to emit alongside the site-wide Organization schema (FAQPage, BreadcrumbList, Service, Person, etc.) */
  schema?: Record<string, unknown>[];
  /** Set true for error/utility pages that shouldn't be indexed */
  noindex?: boolean;
}

const { title, description, ogImage = '/og-image.jpg', schema = [], noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const logoURL = new URL('/favicon.svg', Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://www.indispensabledigital.com/#organization',
  name: 'Indispensable Digital',
  alternateName: 'Indispensable Digital Growth Consultancy',
  description:
    'A premium growth consultancy for founders who intend to lead their category. Growth strategy, brand positioning, PR, content, and performance marketing engineered as one integrated system.',
  slogan: 'Built to Make Brands Indispensable',
  url: 'https://www.indispensabledigital.com',
  logo: logoURL,
  image: logoURL,
  email: 'contact@indispensabledigital.com',
  telephone: '+91-7000123171',
  priceRange: '$$',
  founder: {
    '@type': 'Person',
    name: 'Gaurav Gangwar',
    jobTitle: 'Founder',
    url: 'https://www.indispensabledigital.com/about/',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'New Delhi',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+91-7000123171',
    email: 'contact@indispensabledigital.com',
    areaServed: 'Worldwide',
    availableLanguage: ['English', 'Hindi'],
  },
  knowsAbout: [
    'Growth Strategy',
    'Brand Positioning',
    'PR & Communications',
    'Content Strategy',
    'YouTube Growth',
    'Performance Marketing',
    'Customer Acquisition',
    'Marketing Intelligence',
  ],
  sameAs: ['https://www.linkedin.com/company/indispensabledigital/'],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://www.indispensabledigital.com/#website',
  name: 'Indispensable Digital',
  url: 'https://www.indispensabledigital.com',
  publisher: { '@id': 'https://www.indispensabledigital.com/#organization' },
  inLanguage: 'en-IN',
};

// Bump this date whenever page content is meaningfully updated — it feeds the
// dateModified freshness signal search engines and AI answer engines use.
const SITE_LAST_UPDATED = '2026-07-05';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL.toString(),
  name: title,
  description,
  isPartOf: { '@id': 'https://www.indispensabledigital.com/#website' },
  about: { '@id': 'https://www.indispensabledigital.com/#organization' },
  inLanguage: 'en-IN',
  datePublished: '2026-07-05',
  dateModified: SITE_LAST_UPDATED,
};

const jsonLdBlocks = [orgSchema, webSiteSchema, webPageSchema, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Indispensable Digital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
