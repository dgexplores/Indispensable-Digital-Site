---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Indispensable Digital"
  description="The page you're looking for doesn't exist. Return to Indispensable Digital's homepage."
  noindex
>
  <section class="page-hero" style="padding-bottom:130px">
    <div class="hero-bg"></div>
    <div class="wrap" style="text-align:center">
      <div class="eyebrow">404</div>
      <h1>This page isn't <span class="copper">indispensable.</span></h1>
      <p style="margin:0 auto 36px">The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </section>
</BaseLayout>
