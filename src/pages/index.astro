---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CtaSection from '../components/CtaSection.astro';
import Faq from '../components/Faq.astro';
import DefinitionBlock from '../components/DefinitionBlock.astro';
import VisualStory from '../components/VisualStory.astro';

const faqs = [
  {
    q: 'What does a growth consultancy actually do?',
    a: "A growth consultancy diagnoses the real constraints on a company's growth, then designs and executes the strategy, brand positioning, and marketing systems needed to remove them - rather than simply running isolated campaigns. Indispensable Digital integrates growth strategy, brand positioning, content, PR, and performance marketing into one system built around a single commercial outcome: making your brand the default choice in its category.",
  },
  {
    q: 'How is Indispensable Digital different from a traditional marketing agency?',
    a: 'Traditional agencies typically sell deliverables and hours, and optimize campaigns in isolation. Indispensable Digital operates as an integrated growth partner - every engagement is led by senior strategists, strategy and execution are handled as one system, and success is measured on pipeline, revenue, and market position rather than clicks or impressions.',
  },
  {
    q: 'Who is Indispensable Digital a good fit for?',
    a: 'We work best with founders and leadership teams who are ready to commit to a category-leadership strategy rather than one-off campaigns - typically early-to-growth-stage brands and creators who need senior strategic direction alongside hands-on execution.',
  },
  {
    q: 'What services are included in an engagement?',
    a: 'Depending on the engagement, we bring together growth strategy, brand positioning, PR and communications, content strategy, YouTube growth, performance marketing, customer acquisition systems, and marketing intelligence - integrated as a single system rather than sold as separate line items.',
  },
  {
    q: 'How do I get started?',
    a: "Book a strategy call. It's a direct conversation with a senior strategist - not a sales pitch - to pressure-test your current growth thesis and identify where the real leverage is.",
  },
  {
    q: "What's the difference between a growth consultancy and a marketing agency?",
    a: "Most marketing agencies are structured around executing campaigns you've already decided on - ads, content calendars, social posting. A growth consultancy like Indispensable Digital starts a step earlier: diagnosing the actual constraint on growth, setting the category position, and then building the marketing systems to execute that strategy, with one team accountable for the whole outcome.",
  },
  {
    q: 'How do I choose the right brand positioning partner?',
    a: 'Look for a partner who starts with your commercial strategy, not a moodboard - positioning that isn\'t grounded in how you actually win the category rarely survives contact with the market. Also check whether senior strategists stay involved through execution, or whether the work gets handed off to junior teams after the pitch.',
  },
  {
    q: 'Can a growth consultancy replace my in-house marketing team?',
    a: "It depends on your stage. Early on, a growth consultancy often acts as the strategic and executional core before an in-house team exists. For companies with an existing team, we typically operate as a senior strategic layer - setting direction and structure that an in-house team then runs day to day.",
  },
];

const capabilities = ['Growth strategy', 'Brand positioning', 'Paid search', 'SEO & AEO', 'Conversion systems', 'Analytics', 'Web experiences'];
const operatingPrinciples = ['Senior-led engagements', 'One accountable team', 'Revenue-focused decisions', 'Strategy through execution', 'Worldwide from New Delhi'];
---

<BaseLayout
  title="Performance Marketing Agency | Indispensable Digital"
  description="A performance marketing agency - Google Ads, Meta Ads, SEO, brand positioning and content built as one system for category-leading brands."
>
  <!-- HERO -->
  <section class="hero" id="top">
    <div class="wrap">
      <div class="hero-layout">
        <div class="hero-copy t-stagger">
          <div class="eyebrow t-stagger-line t-stagger-line--1">Independent growth consultancy</div>
          <h1 class="t-stagger-line t-stagger-line--2"><span class="hero-line">Make your brand</span><span class="hero-line signal-type">the default.</span></h1>
          <p class="hero-sub t-stagger-line t-stagger-line--3">We align strategy, positioning and performance so your brand becomes understood, preferred and chosen.</p>
          <div class="hero-btns t-stagger-line t-stagger-line--4">
            <a href="/contact/#book-call" class="btn btn-primary">Start a conversation <span aria-hidden="true">↗</span></a>
            <a href="/work/" class="text-link">Explore how we work <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="growth-graph t-tilt" aria-label="Animated graph showing strategy, brand, demand and experience aligning to create preference and make a brand the default choice">
          <div class="growth-graph-card t-tilt-card">
            <div class="graph-head"><span>How preference compounds</span><strong>One connected system</strong></div>
            <svg viewBox="0 0 620 500" role="img" aria-labelledby="growth-graph-title growth-graph-description">
              <title id="growth-graph-title">The path to becoming the default choice</title>
              <desc id="growth-graph-description">Strategy, brand, demand and experience converge into clarity, build preference and compound into a default market position.</desc>
              <defs>
                <linearGradient id="graph-flow-gradient" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#79e6ff" stop-opacity=".48" />
                  <stop offset=".55" stop-color="#79e6ff" />
                  <stop offset="1" stop-color="#6b7cff" />
                </linearGradient>
                <marker id="graph-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M1 1L9 5L1 9" fill="none" stroke="#79e6ff" stroke-width="1.5" />
                </marker>
              </defs>

              <path class="graph-grid" d="M42 82H582M42 166H582M42 250H582M42 334H582M42 418H582M126 52V448M232 52V448M338 52V448M444 52V448M550 52V448" />

              <path class="input-path path-strategy" d="M112 105C188 105 205 196 286 250" />
              <path class="input-path path-brand" d="M112 202C190 202 217 230 286 250" />
              <path class="input-path path-demand" d="M112 298C190 298 217 270 286 250" />
              <path class="input-path path-experience" d="M112 395C188 395 205 304 286 250" />
              <path class="outcome-path" d="M310 250C355 250 371 250 410 250S474 250 538 250" marker-end="url(#graph-arrow)" />

              <g class="source-node source-strategy"><circle cx="92" cy="105" r="10"/><text x="92" y="82">STRATEGY</text></g>
              <g class="source-node source-brand"><circle cx="92" cy="202" r="10"/><text x="92" y="179">BRAND</text></g>
              <g class="source-node source-demand"><circle cx="92" cy="298" r="10"/><text x="92" y="334">DEMAND</text></g>
              <g class="source-node source-experience"><circle cx="92" cy="395" r="10"/><text x="92" y="431">EXPERIENCE</text></g>

              <g class="stage-node stage-clear"><circle cx="298" cy="250" r="17"/><text x="298" y="293">CLARITY</text></g>
              <g class="stage-node stage-preferred"><circle cx="422" cy="250" r="22"/><text x="422" y="293">PREFERRED</text></g>
              <g class="stage-node stage-default">
                <circle class="default-orbit default-orbit-a" cx="548" cy="250" r="43"/>
                <circle class="default-orbit default-orbit-b" cx="548" cy="250" r="33"/>
                <circle class="default-core" cx="548" cy="250" r="24"/>
                <text x="548" y="315">DEFAULT</text>
              </g>

              <circle class="signal-particle signal-a" r="4"><animateMotion dur="3.8s" repeatCount="indefinite" path="M112 105C188 105 205 196 286 250" /></circle>
              <circle class="signal-particle signal-b" r="4"><animateMotion dur="3.8s" begin="-.9s" repeatCount="indefinite" path="M112 202C190 202 217 230 286 250" /></circle>
              <circle class="signal-particle signal-c" r="4"><animateMotion dur="3.8s" begin="-1.8s" repeatCount="indefinite" path="M112 298C190 298 217 270 286 250" /></circle>
              <circle class="signal-particle signal-d" r="4"><animateMotion dur="3.8s" begin="-2.7s" repeatCount="indefinite" path="M112 395C188 395 205 304 286 250" /></circle>
              <circle class="signal-particle signal-outcome" r="5"><animateMotion dur="2.9s" begin="-.4s" repeatCount="indefinite" path="M310 250C355 250 371 250 410 250S474 250 528 250" /></circle>
            </svg>
            <div class="graph-legend"><span>Align the inputs</span><i aria-hidden="true"></i><span>Earn preference</span><i aria-hidden="true"></i><strong>Become the default</strong></div>
            <div class="t-tilt-glare" aria-hidden="true"></div>
          </div>
        </div>
      </div>
      <div class="hero-principles" aria-label="Our operating principles">
        <div><small>Position</small><span>Choose the category you can own.</span></div>
        <div><small>Build</small><span>Connect every channel to one thesis.</span></div>
        <div><small>Convert</small><span>Turn attention into measurable demand.</span></div>
        <div><small>Compound</small><span>Make every insight improve the next move.</span></div>
      </div>
    </div>
  </section>

  <section class="capability-rail" aria-label="Capabilities and operating principles">
    <div class="marquee-row marquee-row-primary">
      <div class="marquee-track">
        {[0, 1].map((group) => (
          <div class="marquee-group" aria-hidden={group === 1 ? 'true' : undefined}>
            {capabilities.map((item) => <><span>{item}</span><i></i></>)}
          </div>
        ))}
      </div>
    </div>
    <div class="marquee-row marquee-row-secondary">
      <div class="operating-strip">
        {operatingPrinciples.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto pad">
    <div class="wrap">
      <div class="manifesto-grid">
        <div class="manifesto-label">Our point of view</div>
        <blockquote>Attention is rented.<br><span class="signal-type">Preference is built.</span></blockquote>
        <p>Marketing works harder when the market already understands why you are the obvious choice. We create that understanding, then turn it into demand.</p>
      </div>
    </div>
  </section>

  <VisualStory
    tone="surface"
    image="/images/visual-stories/growth-system.jpg"
    alt="A dimensional strategy system with brand, demand, audience and direction modules converging around one connected core"
    heading="One thesis. Every move <span class='copper'>connected.</span>"
    body="We turn separate marketing activities into a connected operating system. Strategy sets direction, brand earns preference, and performance converts it into demand."
    points={[
      'Strategy defines where to play',
      'Positioning makes the choice obvious',
      'Demand systems create momentum',
      'Learning compounds the advantage',
    ]}
    caption="The operating model: four disciplines, one accountable growth system."
    motion="drift"
  />

  <!-- SERVICES -->
  <section class="pad" id="services">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">What We Do</div>
        <h2>Eight disciplines. One outcome: <span class="copper">market leadership.</span></h2>
        <p>Most agencies sell activity. We engineer advantage - integrating strategy, brand, and performance into a single system built to make you the default choice in your category.</p>
      </div>
      <DefinitionBlock
        term="Indispensable Digital is a growth consultancy"
        definition="that integrates growth strategy, brand positioning, PR and communications, content strategy, and performance marketing into a single system - built to make founder-led brands the default choice in their category, rather than just another campaign."
      />
      <ServicesGrid />
      <div style="margin-top:40px">
        <a href="/services/" class="btn btn-ghost">Explore All Services</a>
      </div>
    </div>
  </section>

  <VisualStory
    reverse={true}
    image="/images/visual-stories/demand-compounding.jpg"
    alt="A sculptural performance system where signals move through a funnel into attribution rings and rising growth bars"
    heading="We make performance <span class='copper'>legible.</span>"
    body="Every signal is connected to a commercial decision. We show what creates demand, what converts it, and where the next unit of investment should go."
    points={[
      'One measurement language',
      'Clear channel accountability',
      'Decisions tied to revenue',
      'Insights carried into the next cycle',
    ]}
    caption="Measurement designed for decisions, not reporting theatre."
    motion="reveal"
  />

  <!-- WHY -->
  <section class="pad" id="why">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Why Indispensable</div>
        <h2>An agency runs your marketing.<br>We make your brand <span class="copper">indispensable.</span></h2>
      </div>
      <div class="why-grid">
        <div class="why-col why-them">
          <h3>The Typical Agency</h3>
          <ul>
            <li><span class="idx">01</span> Sells deliverables and hours</li>
            <li><span class="idx">02</span> Optimizes campaigns in isolation</li>
            <li><span class="idx">03</span> Measures clicks and impressions</li>
            <li><span class="idx">04</span> Reacts to briefs</li>
            <li><span class="idx">05</span> Interchangeable with the next vendor</li>
          </ul>
        </div>
        <div class="why-col why-us">
          <h3>Indispensable Digital</h3>
          <ul>
            <li><span class="idx">01</span> Owns commercial outcomes and category position</li>
            <li><span class="idx">02</span> Integrates strategy, brand and performance as one system</li>
            <li><span class="idx">03</span> Measures pipeline, revenue and market share</li>
            <li><span class="idx">04</span> Sets the strategic agenda at the board level</li>
            <li><span class="idx">05</span> Becomes the partner you can't operate without</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <VisualStory
    tone="dark"
    image="/images/visual-stories/senior-collaboration.jpg"
    alt="A senior team assembling separate strategic paths into one clear route toward a shared goal"
    heading="Senior thinking stays <span class='signal-type'>in the work.</span>"
    body="No pitch team, handoff, or disconnected specialist silos. Senior strategists work with your team from the first diagnosis through execution and learning."
    points={[
      'Senior-led from start to finish',
      'One team across every discipline',
      'Shared decisions, visible reasoning',
      'Direct accountability for outcomes',
    ]}
    caption="A partnership model built around shared context and continuous senior involvement."
    motion="float"
  />

  <Faq items={faqs} eyebrow="Common Questions" heading="Everything founders ask before working with us." />

  <CtaSection />
</BaseLayout>
