---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DefinitionBlock from '../../components/DefinitionBlock.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Conversion Rate Optimization',
  provider: { '@id': 'https://www.indispensabledigital.com/#organization' },
  areaServed: 'Worldwide',
  description:
    'Conversion rate optimization — landing page and funnel audits, A/B testing, and checkout optimization built to convert the traffic you already have.',
};

const faqs = [
  {
    q: "How is CRO different from web design?",
    a: 'Web design is about how a page looks and functions. CRO is the systematic process of testing what actually gets more visitors to convert — layout, copy, offers, checkout flow — using data and experiments rather than opinion. A well-designed page can still convert poorly without CRO behind it.',
  },
  {
    q: 'How long before we see a conversion uplift?',
    a: "Simple fixes from an initial audit (page speed, form friction, unclear offers) can show impact within weeks. Structured A/B testing programs typically need enough traffic volume to reach statistical significance, so timelines depend on your current traffic — we scope this honestly before starting.",
  },
  {
    q: 'Do we need a lot of existing traffic for CRO to work?',
    a: "You need enough traffic to run valid tests, which we'll assess upfront. If traffic is too low for formal A/B testing, we start with a heuristic audit and highest-confidence fixes instead of running tests that won't reach significance.",
  },
  {
    q: 'What pages do you typically optimize first?',
    a: "Usually wherever the biggest drop-off in your funnel already is — often the landing page, product page, or checkout flow — rather than optimizing pages evenly across the site regardless of traffic or impact.",
  },
];
---

<BaseLayout
  title="Conversion Rate Optimization (CRO) Services | Indispensable Digital"
  description="Conversion rate optimization — landing page and funnel audits, A/B testing, and checkout optimization built to convert the traffic you already have."
  schema={[serviceSchema]}
>
  <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: 'CRO', href: '/services/cro/' }]} />

  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="wrap">
      <div class="eyebrow">Conversion Rate Optimization</div>
      <h1>Convert more of the traffic <span class="copper">you're already paying for.</span></h1>
      <p>Landing page and funnel audits, A/B testing, and checkout optimization — built to lift conversion rate before you spend more on acquisition.</p>
    </div>
  </section>

  <section class="pad" style="padding-top:40px">
    <div class="wrap">
      <DefinitionBlock
        term="Conversion rate optimization"
        definition="is the systematic process of testing and improving what happens after a visitor lands on your site — page structure, offers, and checkout flow — so the traffic you already have converts at a higher rate."
      />
      <div class="section-head" style="margin:48px 0 32px">
        <div class="eyebrow">What's Included</div>
        <h2 style="font-size:clamp(1.6rem,3vw,2.2rem)">Everything covered in this engagement.</h2>
      </div>
      <div class="why-grid" style="grid-template-columns:1fr">
        <div class="why-col why-us" style="border-left:none">
          <ul>
            <li><span class="tick">✓</span> Landing page and funnel audits</li>
            <li><span class="tick">✓</span> A/B and multivariate testing</li>
            <li><span class="tick">✓</span> Checkout and form optimization</li>
            <li><span class="tick">✓</span> Heatmap and session recording analysis</li>
            <li><span class="tick">✓</span> Ongoing testing roadmap tied to revenue impact</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} eyebrow="CRO FAQ" heading="Questions about conversion rate optimization." />

  <CtaSection
    heading="Ready to fix the leak <span class='copper'>before scaling spend?</span>"
    sub="Book a strategy call and we'll walk through where your funnel is losing the most conversions — no pitch, just a straight read."
  />
</BaseLayout>
