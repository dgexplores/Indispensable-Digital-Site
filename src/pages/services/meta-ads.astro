---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DefinitionBlock from '../../components/DefinitionBlock.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Meta Ads Management',
  provider: { '@id': 'https://www.indispensabledigital.com/#organization' },
  areaServed: 'Worldwide',
  description:
    'Facebook and Instagram advertising management — audience strategy, creative testing, and full-funnel budget allocation built around qualified leads and sales.',
};

const faqs = [
  {
    q: "What's the difference between Meta Ads and Google Ads?",
    a: 'Google Ads captures existing intent — people already searching for a solution. Meta Ads (Facebook and Instagram) create demand by reaching people based on interests, behavior and lookalike audiences before they start searching. Most brands need both, but the strategy and creative for each are different.',
  },
  {
    q: 'Do you handle ad creative production?',
    a: "We direct and brief creative — angles, hooks, formats that perform on Meta — and can produce or work with your existing creative team or content library. Creative testing velocity is usually the biggest lever on Meta, so it's built into the management, not treated as a separate line item.",
  },
  {
    q: 'Do you set up retargeting as part of Meta Ads management?',
    a: "Yes. Meta Pixel and Conversions API setup, audience segmentation, and retargeting sequences across the funnel are part of the core management — not an add-on.",
  },
  {
    q: 'Is Meta Ads a good fit for ecommerce and D2C brands?',
    a: 'Yes — Meta remains one of the strongest acquisition and retargeting channels for ecommerce and D2C brands specifically, when paired with accurate tracking (Pixel + Conversions API) and product-page-aligned creative.',
  },
];
---

<BaseLayout
  title="Meta Ads Agency — Facebook & Instagram Ads | Indispensable Digital"
  description="Meta Ads management for Facebook and Instagram — audience strategy, creative testing, and full-funnel budgeting built for qualified leads and sales."
  schema={[serviceSchema]}
>
  <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: 'Meta Ads', href: '/services/meta-ads/' }]} />

  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="wrap">
      <div class="eyebrow">Paid Social</div>
      <h1>Meta Ads that turn <span class="copper">attention into revenue.</span></h1>
      <p>Facebook and Instagram advertising — audience strategy, creative testing, and full-funnel budget allocation — measured on qualified leads and sales, not impressions.</p>
    </div>
  </section>

  <section class="pad" style="padding-top:40px">
    <div class="wrap">
      <DefinitionBlock
        term="A Meta Ads agency"
        definition="manages Facebook and Instagram advertising — audience strategy, creative testing, and budget allocation across the funnel — so paid social drives qualified leads and sales, not just impressions."
      />
      <div class="why-grid" style="grid-template-columns:1fr">
        <div class="why-col why-us" style="border-left:none">
          <h3>What's included</h3>
          <ul>
            <li><span class="tick">✓</span> Meta Pixel and Conversions API setup</li>
            <li><span class="tick">✓</span> Full-funnel campaign structure — awareness, consideration, conversion</li>
            <li><span class="tick">✓</span> Creative direction and ongoing creative testing</li>
            <li><span class="tick">✓</span> Audience segmentation and retargeting strategy</li>
            <li><span class="tick">✓</span> Reporting tied to leads, sales and CAC — not reach</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} eyebrow="Meta Ads FAQ" heading="Questions about Meta Ads management." />

  <CtaSection
    heading="Ready to make paid social <span class='copper'>a revenue channel?</span>"
    sub="Book a strategy call and we'll show you where your current Meta account is leaving performance on the table — no pitch, just a straight read."
  />
</BaseLayout>
