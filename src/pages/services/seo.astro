---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DefinitionBlock from '../../components/DefinitionBlock.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Technical SEO Services',
  provider: { '@id': 'https://www.indispensabledigital.com/#organization' },
  areaServed: 'Worldwide',
  description:
    'Technical and on-page SEO — crawlability, structured data, Core Web Vitals, and content strategy aligned to real search intent — for organic growth that compounds.',
};

const faqs = [
  {
    q: "What's the difference between technical SEO and on-page SEO?",
    a: "Technical SEO is the foundation — crawlability, indexing, site speed, structured data, and Core Web Vitals — that determines whether search engines can properly access and understand your site. On-page SEO is the content and structure layer built on top of that foundation: titles, headings, internal linking, and content aligned to search intent. You need both; technical issues cap how much on-page work can achieve.",
  },
  {
    q: 'Do you offer ecommerce SEO specifically?',
    a: 'Yes. Ecommerce sites have SEO challenges that content sites don\'t — faceted navigation, duplicate product content, category page structure, and Shopify or platform-specific constraints — and we structure the technical and content work around those specifics.',
  },
  {
    q: 'How long does it take to see results from SEO?',
    a: "Technical fixes can show measurable crawl and indexing improvements within weeks. Ranking and traffic growth from content and authority-building work typically compounds over several months — SEO is a durable asset, not a campaign with a fixed end date.",
  },
  {
    q: 'Do you handle both audits and ongoing SEO work?',
    a: 'Yes — engagements can start with a standalone technical SEO audit, or run as ongoing SEO management covering technical health, content strategy, and rank tracking together.',
  },
];
---

<BaseLayout
  title="Technical SEO Services & SEO Agency | Indispensable Digital"
  description="Technical and on-page SEO — crawlability, structured data, Core Web Vitals, and content aligned to real search intent, from a performance marketing agency."
  schema={[serviceSchema]}
>
  <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: 'SEO', href: '/services/seo/' }]} />

  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="wrap">
      <div class="eyebrow">Organic Growth</div>
      <h1>SEO built on a <span class="copper">technical foundation.</span></h1>
      <p>Crawlability, structured data, and Core Web Vitals, paired with content strategy aligned to real search intent — organic growth that compounds instead of a monthly report nobody reads.</p>
    </div>
  </section>

  <section class="pad" style="padding-top:40px">
    <div class="wrap">
      <DefinitionBlock
        term="Technical SEO"
        definition="is the foundation work that lets search engines properly crawl, index and rank your site — site speed, structured data, crawlability, and on-page optimization — paired with a content strategy built around real search intent."
      />
      <div class="section-head" style="margin:48px 0 32px">
        <div class="eyebrow">What's Included</div>
        <h2 style="font-size:clamp(1.6rem,3vw,2.2rem)">Everything covered in our SEO work.</h2>
      </div>
      <div class="why-grid" style="grid-template-columns:1fr">
        <div class="why-col why-us" style="border-left:none">
          <ul>
            <li><span class="tick">✓</span> Technical SEO audit — crawlability, indexing, Core Web Vitals</li>
            <li><span class="tick">✓</span> On-page SEO — titles, structure, internal linking</li>
            <li><span class="tick">✓</span> Structured data and schema markup</li>
            <li><span class="tick">✓</span> Content strategy aligned to search intent</li>
            <li><span class="tick">✓</span> Ongoing rank tracking and reporting</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} eyebrow="SEO FAQ" heading="Questions about our SEO services." />

  <CtaSection
    heading="Ready to fix the foundation <span class='copper'>before scaling content?</span>"
    sub="Book a strategy call and we'll walk through a quick technical read on your current site — no pitch, just a straight answer."
  />
</BaseLayout>
