---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const articleVisual = post.id.includes('youtube')
  ? { src: '/images/visual-stories/senior-collaboration.jpg', alt: 'A team assembling connected paths toward a shared audience goal' }
  : post.id.includes('ads')
    ? { src: '/images/visual-stories/demand-compounding.jpg', alt: 'A precise performance system turning signals into compounding growth' }
    : { src: '/images/visual-stories/growth-system.jpg', alt: 'A connected system joining strategy, brand, demand and customer experience' };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: 'https://www.indispensabledigital.com/about/',
  },
  publisher: { '@id': 'https://www.indispensabledigital.com/#organization' },
  mainEntityOfPage: `https://www.indispensabledigital.com/blog/${post.id}/`,
};
---

<BaseLayout
  title={`${post.data.title} | Indispensable Digital`}
  description={post.data.description}
  schema={[articleSchema]}
>
  <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: post.data.title, href: `/blog/${post.id}/` }]} />

  <section class="page-hero" style="padding-bottom:40px">
    <div class="hero-bg"></div>
    <div class="wrap">
      <div class="eyebrow">Insights</div>
      <h1>{post.data.title}</h1>
    </div>
  </section>

  <section class="pad" style="padding-top:0">
    <div class="wrap">
      <figure class="article-visual">
        <img src={articleVisual.src} alt={articleVisual.alt} width="1536" height="1152" decoding="async" />
      </figure>
      <div class="blog-meta">
        <time datetime={post.data.publishDate.toISOString()}>{dateFormatter.format(post.data.publishDate)}</time>
        <span>·</span>
        <span>{post.data.author}</span>
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
