---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Server Error | Indispensable Digital"
  description="Something went wrong on our end. Please try again shortly."
  noindex
>
  <section class="page-hero" style="padding-bottom:130px">
    <div class="hero-bg"></div>
    <div class="wrap" style="text-align:center">
      <div class="eyebrow">500</div>
      <h1>Something broke on <span class="copper">our end.</span></h1>
      <p style="margin:0 auto 36px">We're on it. Please refresh the page in a moment, or head back to the homepage.</p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </section>
</BaseLayout>
