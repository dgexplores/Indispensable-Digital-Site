---
import BrandLogo from './BrandLogo.astro';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="/" aria-label="Indispensable Digital - home">
          <BrandLogo />
        </a>
        <p>Strategy, positioning and performance systems for brands determined to become the default choice.</p>
        <a class="footer-cta" href="/contact/#book-call">Start a conversation <span>↗</span></a>
      </div>
      <div class="foot-col">
        <h4>Services</h4>
        <a href="/services/brand-strategy/">Brand Strategy</a>
        <a href="/services/seo/">AEO &amp; SEO</a>
        <a href="/services/google-ads/">Google Ads</a>
        <a href="/services/meta-ads/">Meta Ads</a>
        <a href="/services/ecommerce-marketing/">Ecommerce Marketing</a>
        <a href="/services/web-development/">Web Development</a>
      </div>
      <div class="foot-col">
        <h4>Company</h4>
        <a href="/about/">About</a>
        <a href="/approach/">Our Approach</a>
        <a href="/work/">Ways to Work</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
      </div>
      <div class="foot-col">
        <h4>Connect</h4>
        <a href="https://www.linkedin.com/company/indispensabledigital/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://www.instagram.com/indispensabledigital_/" target="_blank" rel="noopener">Instagram</a>
        <a href="mailto:contact@indispensabledigital.com" class="foot-email">contact@indispensabledigital.com</a>
        <a href="tel:+917000123171">+91-7000123171</a>
        <a href="/">www.indispensabledigital.com</a>
        <span class="foot-location">New Delhi, India · Working worldwide</span>
      </div>
    </div>
    <div class="foot-bottom">
      <p>© {year} Indispensable Digital. All rights reserved.</p>
      <div class="foot-tag">Position <span>→</span> Build <span>→</span> Compound</div>
    </div>
  </div>
</footer>
