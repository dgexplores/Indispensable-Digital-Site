---
interface QA {
  q: string;
  a: string;
}

interface Props {
  items: QA[];
  heading?: string;
  eyebrow?: string;
}

const { items, heading = 'Frequently Asked Questions', eyebrow = 'FAQ' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="pad faq-section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">{eyebrow}</div>
      <h2>{heading}</h2>
    </div>
    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item" name={`faq-${Math.random()}`}>
          <summary>
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

