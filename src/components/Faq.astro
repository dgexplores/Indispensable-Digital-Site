---
interface QA {
  q: string;
  a: string;
}

interface Props {
  items: QA[];
  heading?: string;
  eyebrow?: string;
}

const { items, heading = 'Frequently Asked Questions', eyebrow = 'FAQ' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="pad faq-section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">{eyebrow}</div>
      <h2>{heading}</h2>
    </div>
    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item" name={`faq-${Math.random()}`}>
          <summary>
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-list{max-width:820px}
  .faq-item{border-bottom:1px solid var(--line-soft);padding:22px 0}
  .faq-item summary{display:flex;justify-content:space-between;align-items:center;gap:20px;cursor:pointer;list-style:none;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:600;color:var(--cream)}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-icon{flex-shrink:0;color:var(--copper-2);font-size:1.4rem;font-family:'Inter',sans-serif;transition:.25s;line-height:1}
  .faq-item[open] .faq-icon{transform:rotate(45deg)}
  .faq-item p{color:var(--muted);font-weight:300;font-size:.98rem;margin-top:16px;max-width:700px}
</style>
