---
interface QA {
  q: string;
  a: string;
}

interface Props {
  items: QA[];
  heading?: string;
  eyebrow?: string;
}

const { items, heading = 'Frequently Asked Questions', eyebrow = 'FAQ' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="pad faq-section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">{eyebrow}</div>
      <h2>{heading}</h2>
    </div>
    <div class="faq-list" data-faq-list>
      {items.map((item, i) => (
        <div class="faq-item t-acc" data-open="false">
          <button class="faq-question t-acc-head" aria-expanded="false" aria-controls={`faq-panel-${i}`}>
            <span>{item.q}</span>
            <span class="t-acc-chevron" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M4 6.5L8 10.5L12 6.5" /></svg>
            </span>
          </button>
          <div class="t-acc-panel" id={`faq-panel-${i}`}>
            <div class="t-acc-panel-inner"><p>{item.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  document.querySelectorAll<HTMLElement>('.t-acc').forEach((acc) => {
    const head = acc.querySelector<HTMLButtonElement>('.t-acc-head');
    head?.addEventListener('click', () => {
      const open = acc.getAttribute('data-open') === 'true';
      acc.setAttribute('data-open', String(!open));
      head.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
