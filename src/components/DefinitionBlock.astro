---
interface Props {
  term: string;
  definition: string;
}
const { term, definition } = Astro.props;
---

<div class="definition-block">
  <p><strong>{term}</strong> {definition}</p>
</div>

<style>
  .definition-block{max-width:840px;background:rgba(210,82,31,.08);border-left:3px solid var(--copper);border-radius:0 10px 10px 0;padding:22px 28px;margin:0 0 48px}
  .definition-block p{color:var(--cream);font-size:1.02rem;font-weight:300;line-height:1.65;margin:0}
  .definition-block strong{color:var(--copper-2);font-weight:600}
</style>
