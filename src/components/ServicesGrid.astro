    icon: '<path d="M4 5h16M4 12h16M4 19h9"/>',
  },
  {
    no: '05',
    title: 'YouTube Growth',
    desc: 'Building owned audiences and authority channels that turn attention into a durable, compounding asset.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"/>',
  },
  {
    no: '06',
    title: 'Performance Marketing',
    desc: 'Profitable, scalable acquisition across paid channels — engineered for efficiency and unit economics, not vanity.',
