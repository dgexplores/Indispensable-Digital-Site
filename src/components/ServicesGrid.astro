---
const services = [
  {
    href: '/approach/',
    title: 'Growth Strategy',
    desc: 'The commercial roadmap - where to play, how to win, and the sequence of moves that compounds your advantage.',
    icon: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  },
  {
    href: '/services/brand-strategy/',
    title: 'Brand Positioning',
    desc: 'A sharp, defensible position that makes competitors irrelevant and makes your brand the obvious answer.',
    icon: '<path d="M12 3l2.5 5 5.5.8-4 3.9.9 5.5L12 16l-4.9 2.6.9-5.5-4-3.9 5.5-.8z"/>',
  },
  {
    href: '/contact/',
    title: 'PR & Communications',
    desc: 'Earned authority. We put your brand in the rooms and headlines that shift perception and command trust.',
    icon: '<path d="M3 11l14-7v16L3 13z"/><path d="M17 8a3 3 0 010 8"/>',
  },
  {
    href: '/blog/',
    title: 'Content Strategy',
    desc: 'A content engine that educates, converts, and builds category ownership - not noise on a calendar.',
    icon: '<path d="M4 5h16M4 12h16M4 19h9"/>',
  },
  {
    href: '/work/',
    title: 'YouTube Growth',
    desc: 'Building owned audiences and authority channels that turn attention into a durable, compounding asset.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"/>',
  },
  {
    href: '/services/google-ads/',
    title: 'Performance Marketing',
    desc: 'Profitable, scalable acquisition across paid channels - engineered for efficiency and unit economics, not vanity.',
    icon: '<path d="M4 19V9m5 10V5m5 14v-7m5 7V3"/>',
  },
  {
    href: '/services/ecommerce-marketing/',
    title: 'Customer Acquisition',
    desc: 'Full-funnel systems that turn strangers into customers into advocates - predictably and at scale.',
    icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0M17 4.5a3.5 3.5 0 010 7M22 20a6.5 6.5 0 00-4-6"/>',
  },
  {
    href: '/services/analytics/',
    title: 'Marketing Intelligence',
    desc: 'The data layer beneath every decision - attribution, insight, and forecasting that de-risk every dollar.',
    icon: '<path d="M3 3v18h18"/><path d="M7 14l3-4 3 3 5-7"/>',
  },
];
---

<div class="services-grid">
  {services.map((s) => (
    <a class="svc" href={s.href}>
      <div class="svc-top"><span class="svc-arrow" aria-hidden="true">↗</span></div>
      <div class="ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" set:html={s.icon} />
      </div>
      <h3>{s.title}</h3>
      <p>{s.desc}</p>
    </a>
  ))}
</div>
